#!/bin/sh
# Secret scan before every commit.
#
# Two lines used to sit above this and made the hook abort on every commit,
# for every developer:
#
#   . "$(dirname "$0")/_/husky.sh"
#   cd packages/desktop-gui
#
# `husky` is not a dependency of this project, so the `_/husky.sh` bootstrap it
# sourced is never generated. Sourcing a missing file is a special-builtin
# failure in POSIX sh, which exits the hook non-zero -- so the commit aborted
# before the scan was ever reached. The `cd` then pointed at a monorepo path
# that does not exist in this repository; package.json is at the root.
#
# Modern husky (v9+) does not need the bootstrap line anyway, so this runs as a
# plain git hook via core.hooksPath and needs no husky install.

echo "Running secret scan..."
npm run secret-scan
if [ $? -ne 0 ]; then
    echo "Secret scan failed. Commit aborted."
    exit 1
fi
