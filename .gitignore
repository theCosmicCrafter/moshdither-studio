/node_modules
/.vscode
/.idea
# Local agent/editor tooling. launch.json holds a machine-specific dev-server
# command, so it is per-developer rather than shared project config.
/.claude/launch.json

# TruffleHog binary and the docs bundled in its release tarball, fetched on
# demand by scripts/secret-scan.ps1. The executable alone is ~170 MB. The rest
# of tools/ is checked-in project scripts, so this ignores the download only.
/tools/trufflehog.exe
/tools/LICENSE
/tools/README.md
/tools/docs/
/dist
/dist-ssr
*.local
.env

# Tauri
/src-tauri/target
/src-tauri/gen
/src-tauri/Cargo.lock
# Platform-specific signing configs generated by the release workflow
/src-tauri/tauri.windows.conf.json
/src-tauri/tauri.macos.conf.json
# Generated release overlay for SAM3 sidecar + model resources
/src-tauri/tauri.release.conf.json

# OS
.DS_Store
Thumbs.db

# Test artifacts
/tests/fixtures/output
/coverage
/test-outputs
*.tsbuildinfo

# live-preview-param-update.spec.ts writes fresh before/after diffs on every
# run; cpu.png/webgl.png in the same directory are committed goldens and stay tracked.
/tests/e2e/output/param-update-*.png

# Downloaded SAM3 checkpoint (fetched at build time).
#
# The WEIGHTS are ignored (see the /models/**/*.pt rules below), but the
# DIRECTORY must exist: tauri.conf.json lists "../models" under `resources`, and
# Tauri's build script aborts with
#
#     resource path `../models` doesn't exist
#
# if it is missing. This used to be a blanket `/models`, which contradicted the
# comment further down saying "the directory is tracked" and meant a fresh clone
# could not build at all -- not just in CI, for anyone cloning the repository.
/models/*
!/models/sam3/

# Ignore .git files/worktrees to prevent Tauri build scanner issues
**/.git
**/.git.bak

# FFmpeg sidecars (downloaded at build time)
/src-tauri/binaries/*.exe
/src-tauri/binaries/ffmpeg*
/src-tauri/binaries/ffprobe*
/src-tauri/bin/*.exe
/assets/bin/

# Python venvs
/audit_venv
/sam3_env
/packages/python-backend/venv

# SAM3 sidecar binaries (built per target in CI / local release builds)
/src-tauri/bin/sam3-bridge*

# Local checkouts of the SAM3 upstream repo (facebookresearch/sam3),
# vendored the same way as the Python venvs above rather than as a git
# submodule: sam3_bridge.py needs a build compatible with this project's
# pinned torch version, which requires facebookresearch/sam3 plus a
# "relax torch.load's weights_only constraint to False in
# model_builder's checkpoint loading" patch (newer PyTorch defaults
# weights_only=True, which this checkpoint format doesn't satisfy) --
# see docs/SAM3_SETUP.md for how to obtain a working copy.
# packages/python-backend/sam3_repo is the one sam3_engine.rs's
# resolve_sam3_repo() actually reads; the root-level sam3_repo is a
# second local clone (with its own real git history/remote) kept around
# incidentally, not required by the app.
/packages/python-backend/sam3_repo
/sam3_repo

# Bundled model weights; the directory is tracked but .pt files are not
/models/**/*.pt
/models/**/*.pth
/models/**/*.safetensors

# MCP server dependencies
# Any node_modules at any depth. The root-only '/node_modules' rule above missed
# nested ones, so mcp-servers/mosh-verify/node_modules (3,508 files) was tracked
# for months before anyone noticed.
node_modules/

# Reference/legacy projects (not part of the app, kept for algorithm reference only)
/references

# Python cache
__pycache__/
*.pyc

# Playwright test artifacts
/playwright-report/
/test-results/
/.playwright-mcp/

# PyInstaller / build artifacts
/build/

# Temp/test output files
test_*.txt
*.pyc

# IDE/docs artifacts
/recycling/
/desktop.png

# Scratch/output directory used by audit and export tooling
/outputs/
