/node_modules
/.vscode
/.idea
/dist
/dist-ssr
*.local
.env

# Tauri
/src-tauri/target
/src-tauri/gen
/src-tauri/Cargo.lock
# Platform-specific signing configs generated by the release workflow
/src-tauri/tauri.windows.conf.json
/src-tauri/tauri.macos.conf.json
# Generated release overlay for SAM3 sidecar + model resources
/src-tauri/tauri.release.conf.json

# OS
.DS_Store
Thumbs.db

# Test artifacts
/tests/fixtures/output
/coverage
/test-outputs
*.tsbuildinfo

# Downloaded SAM3 checkpoint (fetched at build time)
/models

# Ignore .git files/worktrees to prevent Tauri build scanner issues
**/.git
**/.git.bak

# FFmpeg sidecars (downloaded at build time)
/src-tauri/binaries/*.exe
/src-tauri/binaries/ffmpeg*
/src-tauri/binaries/ffprobe*
/src-tauri/bin/*.exe
/assets/bin/

# Python venvs
/audit_venv
/sam3_env
/packages/python-backend/venv

# SAM3 sidecar binaries (built per target in CI / local release builds)
/src-tauri/bin/sam3-bridge*

# Bundled model weights; the directory is tracked but .pt files are not
/models/**/*.pt
/models/**/*.pth
/models/**/*.safetensors

# MCP server dependencies
/mcp-servers/*/node_modules

# Reference/legacy projects (not part of the app, kept for algorithm reference only)
/references

# Python cache
__pycache__/
*.pyc

# Playwright test artifacts
/playwright-report/
/test-results/
/.playwright-mcp/

# PyInstaller / build artifacts
/build/

# Temp/test output files
test_*.txt
*.pyc

# IDE/docs artifacts
/recycling/
/desktop.png

# Scratch/output directory used by audit and export tooling
/outputs/
