# =============================================================================
# MoshDither Studio — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in values as needed.
# NEVER commit `.env` to version control — it contains secrets.
# =============================================================================

# ---------------------------------------------------------------------------
# Python Backend RPC Auth
# ---------------------------------------------------------------------------
# A 64-character hex string used to authenticate IPC between the Electron
# main process and the local Python backend. If unset, the main process
# auto-generates a random token on launch.
# MOSHDITHER_RPC_TOKEN=auto

# ---------------------------------------------------------------------------
# Vite Development Server
# ---------------------------------------------------------------------------
# Set by Vite during development. Do not override unless proxying the dev
# server through a custom URL.
# VITE_DEV_SERVER_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Windows Code Signing (EV Certificate)
# ---------------------------------------------------------------------------
# Path or URL to the .pfx code-signing certificate.
# WIN_CSC_LINK=C:\certs\moshdither-ev.pfx
#
# Password for the .pfx file.
# WIN_CSC_KEY_PASSWORD=your_pfx_password_here

# ---------------------------------------------------------------------------
# macOS Code Signing & Notarization
# ---------------------------------------------------------------------------
# Path or URL to the .p12 Developer ID certificate.
# CSC_LINK=/Users/you/certs/moshdither-dev-id.p12
#
# Password for the .p12 file.
# CSC_KEY_PASSWORD=your_p12_password_here
#
# Apple ID for notarization (app-specific password recommended).
# APPLE_ID=developer@example.com
#
# App-specific password for notarization.
# APPLE_ID_PASSWORD=xxxx-xxxx-xxxx-xxxx
#
# Apple Developer Team ID (10-character string).
# TEAM_ID=ABCD123456

# ---------------------------------------------------------------------------
# GitHub Release Publishing
# ---------------------------------------------------------------------------
# Personal Access Token with `repo` scope for electron-builder to publish
# releases to GitHub. Required only when running `electron-builder --publish`.
# GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
