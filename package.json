{
  "name": "moshdither-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .husky')}catch(e){}\"",
    "dev": "vite",
    "prebuild": "node scripts/verify-external-bins.mjs && node scripts/subset-material-symbols.mjs --check",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "verify:external": "node scripts/verify-external-bins.mjs",
    "subset:icons": "node scripts/subset-material-symbols.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "setup:sam3-env": "python scripts/setup-sam3-env.py",
    "build:sam3-sidecar": "python scripts/build-sam3-sidecar.py",
    "download:sam3-checkpoint": "python scripts/download-sam3-checkpoint.py",
    "enable:sam3-sidecar": "node scripts/enable-sam3-sidecar.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "audit:features": "python tools/feature_audit.py",
    "audit:parity": "playwright test tests/e2e/run-parity.spec.ts",
    "secret-scan": "pwsh -ExecutionPolicy Bypass -File scripts/secret-scan.ps1",
    "secret-scan:history": "pwsh -ExecutionPolicy Bypass -File scripts/secret-scan.ps1 -History",
    "verify:icons": "node scripts/subset-material-symbols.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/architects-daughter": "^5.3.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "flexlayout-react": "^0.10.1",
    "meyda": "^5.6.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-audio-beat-detector": "^8.2.37",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  }
}
