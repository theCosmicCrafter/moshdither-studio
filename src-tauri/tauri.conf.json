{
  "productName": "MoshDither Studio",
  "version": "0.1.0",
  "identifier": "com.moshdither.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "MoshDither Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": false,
        "maximized": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: tauri:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'",
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$TEMP/moshdither-studio/**",
            "$APPDATA/com.moshdither.studio/**",
            "$APPCONFIG/com.moshdither.studio/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["bin/ffmpeg", "bin/ffprobe", "bin/ffgac", "bin/ffedit"],
    "resources": {
      "../packages/python-backend": "packages/python-backend",
      "../public/lut": "lut"
    }
  }
}
