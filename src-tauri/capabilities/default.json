{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for MoshDither Studio",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "core:default",
      "scope": {
        "allow": [
          { "path": "$HOME/**" },
          { "path": "$APPDATA/**" },
          { "path": "$APPCONFIG/**" },
          { "path": "$DOWNLOAD/**" },
          { "path": "$DOCUMENT/**" },
          { "path": "$DESKTOP/**" },
          { "path": "$PICTURE/**" },
          { "path": "$VIDEO/**" },
          { "path": "$TEMP/**" }
        ]
      }
    },
    "core:window:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "dialog:default"
  ]
}
